{
  "app": {
    "bundleName": "io.github.dchernykh1984.huaweiracestats",
    "vendor": "dchernykh1984",
    "version": {
      "code": 100,
      "name": "1.0.0"
    }
  },
  "deviceConfig": {},
  "module": {
    "deviceType": [
      "liteWearable"
    ],
    "distro": {
      "deliveryWithInstall": true,
      "moduleName": "entry",
      "moduleType": "entry"
    },
    "abilities": [
      {
        "name": ".MainAbility",
