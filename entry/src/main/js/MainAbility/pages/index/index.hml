<div class="root" style="height: {{ height }}px;">
  <div if="{{ screen === 'stats' }}" class="dashboard" style="height: {{ height }}px; padding-top: {{ height * 0.1 }}px;" onlongpress="openSettings" onswipe="swipeBack">
    <div for="{{ band in bands }}" class="band" style="width: {{ band.width }}px; height: {{ band.height }}px;">
      <div for="{{ cell in band.cells }}" class="cell" style="width: {{ cell.width }}px; height: {{ cell.height }}px;">
        <text class="label" style="font-size: {{ cell.labelSize }}px;">{{ cell.label }}</text>
        <text class="value" style="font-size: {{ cell.valueSize }}px;">{{ cell.value }}</text>
      </div>
    </div>
  </div>
  <list if="{{ screen === 'settings' }}" class="menu" style="height: {{ height }}px;" onswipe="swipeBack">
    <list-item class="spacer"></list-item>
    <list-item class="menu-row"><text class="heading">Race settings</text></list-item>
    <list-item class="menu-row"><text class="choice" onclick="edit('competitionId')">Race: {{ config.competitionId }}</text></list-item>
    <list-item class="menu-row"><text class="choice" onclick="edit('bib')">Bib: {{ config.bib }}</text></list-item>
    <list-item class="menu-row"><text class="choice" onclick="edit('siteUrl')">Site: {{ config.siteUrl }}</text></list-item>
    <list-item class="menu-row"><text class="key" onclick="changeCount(-1)">-</text><text class="count">Fields: {{ config.rowCount }}</text><text class="key" onclick="changeCount(1)">+</text></list-item>
    <list-item for="{{ rowChoices }}" class="menu-row"><text class="choice" onclick="chooseRow($item.index)">{{ $item.label }}</text></list-item>
    <list-item if="{{ error !== '' }}" class="menu-row"><text class="error">{{ error }}</text></list-item>
    <list-item class="menu-row"><text class="choice action" onclick="applySettings">{{ saving ? 'Saving...' : 'Save' }}</text></list-item>
    <list-item class="menu-row"><text class="choice" onclick="cancelSettings">Cancel</text></list-item>
    <list-item class="spacer"></list-item>
  </list>
  <list if="{{ screen === 'edit' }}" class="menu" style="height: {{ height }}px;" onswipe="swipeBack">
    <list-item class="spacer"></list-item>
    <list-item class="menu-row"><text class="heading">{{ editTitle }}</text></list-item>
    <list-item class="menu-row"><text class="edit-value">{{ editText }}</text></list-item>
    <list-item class="menu-row"><text class="control" onclick="erase">Delete</text><text class="control" onclick="clear">Clear</text></list-item>
    <list-item class="menu-row" for="{{ row in keyRows }}"><text class="key" for="{{ key in row.keys }}" onclick="typeKey(key)">{{ key }}</text></list-item>
    <list-item class="menu-row"><text class="control action" onclick="acceptEdit">Done</text><text class="control" onclick="backToSettings">Cancel</text></list-item>
    <list-item class="spacer"></list-item>
  </list>
  <list if="{{ screen === 'metrics' }}" class="menu" style="height: {{ height }}px;" onswipe="swipeBack">
    <list-item class="spacer"></list-item>
    <list-item class="menu-row"><text class="heading">Choose metric</text></list-item>
    <list-item for="{{ metricChoices }}" class="menu-row"><text class="choice" onclick="chooseMetric($item.index)">{{ $item.label }}</text></list-item>
    <list-item class="menu-row"><text class="choice" onclick="backToSettings">Back</text></list-item>
    <list-item class="spacer"></list-item>
  </list>
</div>
